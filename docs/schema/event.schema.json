{
  "$defs": {
    "Point": {
      "properties": {
        "x": {
          "maximum": 100,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    }
  },
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "integer"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "period": {
      "enum": [
        1,
        2
      ],
      "title": "Period",
      "type": "integer"
    },
    "t": {
      "description": "Seconds since kick-off of the match",
      "minimum": 0,
      "title": "T",
      "type": "number"
    },
    "clock": {
      "title": "Clock",
      "type": "string"
    },
    "team_id": {
      "title": "Team Id",
      "type": "string"
    },
    "player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Id"
    },
    "type": {
      "enum": [
        "pass",
        "carry",
        "shot",
        "duel",
        "interception",
        "clearance",
        "recovery",
        "miscontrol",
        "ball_out",
        "foul",
        "goalkeeper",
        "pressure",
        "substitution",
        "card",
        "period_start",
        "period_end"
      ],
      "title": "Type",
      "type": "string"
    },
    "subtype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtype"
    },
    "start": {
      "$ref": "#/$defs/Point"
    },
    "end": {
      "anyOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "success",
            "fail",
            "goal",
            "saved",
            "blocked",
            "off_target"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "meta": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Meta",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "match_id",
    "period",
    "t",
    "clock",
    "team_id",
    "type",
    "start"
  ],
  "title": "Event",
  "type": "object"
}
