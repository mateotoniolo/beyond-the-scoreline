# Microsoft Foundry (Azure OpenAI v1 endpoint of your Foundry resource, trailing slash included)
BTS_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
BTS_FOUNDRY_API_KEY=your-key   # leave empty to use Entra ID (az login or managed identity)
BTS_FOUNDRY_MODEL=gpt-5-mini   # deployment name
BTS_AGENT_MODE=crew            # crew = Agent Framework roles (default with an endpoint) | simple
BTS_QA_ENABLED=true            # "Ask the match" question desk; unset = on whenever the crew is on

# Azure AI Speech (optional; spoken insights and recap). Unset BTS_SPEECH_ENABLED = on when key and region are set.
BTS_SPEECH_KEY=
BTS_SPEECH_REGION=eastus2
BTS_SPEECH_ENDPOINT=            # optional: https://YOUR-RESOURCE.cognitiveservices.azure.com/tts/cognitiveservices/v1
BTS_SPEECH_ENABLED=             # true | false; empty follows the key

# Azure Cosmos DB (optional; profiles fall back to memory when unset)
BTS_COSMOS_ENDPOINT=
BTS_COSMOS_KEY=
BTS_COSMOS_DATABASE=bts

# Application Insights (optional; traces of every agent, model call and tool)
APPLICATIONINSIGHTS_CONNECTION_STRING=

BTS_LOG_LEVEL=INFO
